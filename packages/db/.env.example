# Supabase Postgres URI from Project Settings → Database → Connect.
# Use the direct connection (port 5432) or Session pooler for drizzle-kit migrate.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Copy these into apps/web/.env.local as well (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
